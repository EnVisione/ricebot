# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Your bot token from discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your application ID (Client ID) from discord.com/developers/applications
CLIENT_ID=your_application_id_here

# Guild ID for development command deployment (faster updates)
GUILD_ID=your_guild_id_here

# Set to 'true' to enable debug logging
DEBUG=false

# Set to 'true' to deploy commands globally instead of to a single guild
# Global deployment takes up to 1 hour to propagate
DEPLOY_GLOBAL=false

